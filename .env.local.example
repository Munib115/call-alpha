# Supabase connection credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-private-key

# TURN Server fallback credentials (Metered.ca free tier setup)
NEXT_PUBLIC_TURN_URL=turn:relay.metered.ca:80
NEXT_PUBLIC_TURN_USER=your-metered-username
NEXT_PUBLIC_TURN_PASS=your-metered-credential

# Optional: Metered API Key for secure server-side dynamic credentials rotation
# If provided, /api/turn-creds will pull credentials from Metered.ca automatically.
METERED_API_KEY=your-metered-api-key
